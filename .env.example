# Gemini AI (required)
GEMINI_API_KEY=your_gemini_api_key_here
MODEL_NAME=gemini-2.5-flash
MAX_OUTPUT_TOKENS=4096
# How many past messages of a conversation are sent to the model
HISTORY_LIMIT=20
# Stored messages older than this many days are deleted daily (0 = keep forever)
HISTORY_RETENTION_DAYS=30

# Discord (the Discord adapter starts only when DISCORD_TOKEN is set)
DISCORD_TOKEN=your_discord_bot_token_here
INIT_CHANNEL_ID=your_init_channel_id
BLACKLISTED_CHANNEL_IDS=channel_id_1,channel_id_2
IS_MENTION_ONLY=true
MAX_MESSAGE_LENGTH=2000

# Web server / admin panel
ADMIN_PORT=3000
# Without ADMIN_PASSWORD, /admin only answers requests from this machine.
# Set it before exposing the server (tunnel, reverse proxy, cloud host).
ADMIN_USER=admin
ADMIN_PASSWORD=

# Storage
DATABASE_PATH=database.sqlite

# Timezone used for /remind times (defaults to the server's timezone)
TZ=Asia/Singapore

# Image processing
IMAGE_DOWNLOAD_TIMEOUT=15000
IMAGE_DOWNLOAD_RETRIES=3

# Logging
ENABLE_DEBUG_LOGS=false
